# "Letterboxing" should be treated as a feature/product name, and likely not changed in other languages.
letterboxing-header = Letterboxing
# Preferences - Letterboxing.
# The word "Letterboxing" is the proper noun for the Tor Browser feature, and is therefore capitalised.
# "Letterboxing" should be treated as a feature/product name, and likely not changed in other languages.
letterboxing-overview = { -brand-short-name }s Letterboxing-funktion begränsar webbplatser att visas i specifika storlekar, vilket gör det svårare att peka ut användare utifrån deras fönster- eller skärmstorlek.
# Preferences - Letterboxing.
# The word "Letterboxing" is the proper noun for the Tor Browser feature, and is therefore capitalised.
# "Letterboxing" should be treated as a feature/product name, and likely not changed in other languages.
letterboxing-disabled-description = Letterboxing är för närvarande inaktiverat.
# Preferences - Letterboxing.
# The word "Letterboxing" is the proper noun for the Tor Browser feature, and is therefore capitalised.
# "Letterboxing" should be treated as a feature/product name, and likely not changed in other languages.
letterboxing-enable-button =
    .label = Aktivera Letterboxing
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "14.0" refers to the browser versions number: Tor Browser 14.0.
# "macOS" is a brand name, and 10.15 is the macOS version number.
dropped-support-notification-macos-version-less-than-10-15 = Nästa större version av { -brand-short-name } (14.0) kommer inte längre att stöda den här versionen av macOS. Uppgradera till macOS 10.15 eller senare senast den 1 oktober 2024 för att fortsätta få viktiga säkerhetsuppdateringar.
# Notification for dropped operating system support.
dropped-support-notification-dismiss-button = Jag fattar
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "macOS" is a brand name, and 10.15 is the macOS version number.
dropped-support-notification-macos-version-less-than-10-15-expired = { -brand-short-name } stöder inte längre den här versionen av macOS. Uppgradera till macOS 10.15 eller senare för att fortsätta få viktiga säkerhetsuppdateringar.
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "14.0" refers to the browser versions number: Tor Browser 14.0.
# "Windows" is a brand name, and "Windows 10" is the version.
dropped-support-notification-win-os-version-less-than-10 = Nästa större version av { -brand-short-name } (14.0) kommer inte längre att stöda denna version av Windows. Uppgradera till Windows 10 eller senare senast den 1 oktober 2024 för att fortsätta få viktiga säkerhetsuppdateringar.
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "Windows" is a brand name, and "Windows 10" is the version.
dropped-support-notification-win-os-version-less-than-10-expired = { -brand-short-name } stöder inte längre den här versionen av Windows. Uppgradera till Windows 10 eller senare för att fortsätta få viktiga säkerhetsuppdateringar.
# New identity dialog.
new-identity-dialog-description = { -brand-short-name } stänger alla fönster och flikar. Alla webbplatssessioner kommer att gå förlorade.
# New identity: blocked home page notification.
# '-brand-short-name' is the localized browser name, like "Tor Browser".
# $url (String) - The URL of the home page, possibly shortened.
new-identity-blocked-home-notification = { -brand-short-name } blockerade din hemsida ({ $url }) från att laddas eftersom den kanske känner igen din tidigare session.
