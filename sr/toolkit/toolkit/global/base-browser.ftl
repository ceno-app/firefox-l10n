# "Letterboxing" should be treated as a feature/product name, and likely not changed in other languages.
letterboxing-overview = { -brand-short-name } Летербоксинг опција ограничава вебсајтове да се приказују у одређеној величини, чиме се отежава издвајање корисника на основу њихове величине прозора или величине екрана.
# Language notification
# $language (String) - The language Tor Browser is displayed in (already translated).
language-notification-label-system = { -brand-short-name } је подесио језик приказа на { $language } на основу језика система.
# Language notification
# This is shown when the system language is not supported, so we fall back to another language instead.
# $language (String) - The language Tor Browser is displayed in (already translated).
language-notification-label = { -brand-short-name } је подесио језик приказа на { $language }.
