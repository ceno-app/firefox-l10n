# Language notification
# $language is the language Tor Browser is displayed in (already translated)
language-notification-label-system = { -brand-short-name } heeft je weergavetaal ingesteld op { $language }, gebaseerd op de taal van je systeem.
# Language notification
language-notification-button = Wijzig Taal…
# Language notification
# This is shown when the system language is not supported, so we fall back to another language instead.
# $language is the language Tor Browser is displayed in (already translated).
language-notification-label = { -brand-short-name } heeft je weergavetaal ingesteld op { $language }.
# Fullscreen/maximization notification shown when letterboxing is disabled
basebrowser-rfp-maximize-warning-message = Door Tor Browser te maximaliseren, kunnen websites uw beeldschermgrootte vaststellen, wat kan worden gebruikt om u te traceren. Het wordt aanbevolen de oorspronkelijke grootte van Tor Browser-vensters aan te houden.
# Fullscreen/maximization notification shown when letterboxing is disabled
basebrowser-rfp-restore-window-size-button-label = Herstel
# Fullscreen/maximization notification shown when letterboxing is disabled
basebrowser-rfp-restore-window-size-button-ak = H
# Tooltip for the about:addons recommended badge
basebrowser-addon-badge-recommended = Mozilla beveelt alleen extensies aan die voldoen aan hun standaarden voor beveiliging en prestaties
# Tooltip for the about:addons recommended badge
basebrowser-addon-badge-verified = Mozilla heeft deze extensie beoordeeld dat deze aan hun standaarden voldoet voor beveiliging en prestaties
# About dialog
# "Mozilla Firefox" should be treated like a brand and it should be neither translated nor transliterated.
# $version (String) - The current browser version. E.g. "12.5.3".
# $firefoxVersion (String) - The version number of Firefox the current browser is based on. E.g. "102.15.0esr".
basebrowser-about-dialog-version = { $version }(gebaseerd op Mozilla Firefox){ $firefoxVersion }
