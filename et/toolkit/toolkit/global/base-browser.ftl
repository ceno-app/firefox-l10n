# About dialog
# "Mozilla Firefox" should be treated like a brand and it should be neither translated nor transliterated.
# $version (String) - The current browser version. E.g. "12.5.3".
# $firefoxVersion (String) - The version number of Firefox the current browser is based on. E.g. "102.15.0esr".
basebrowser-about-dialog-version = { $version } (aluseks on Mozilla Firefoxi versioon { $firefoxVersion })
# New identity.
# App menu (hamburger menu) items use sentence case for English (US).
appmenuitem-new-identity =
    .label = Uus identiteet
# New identity.
# Uses sentence case for English (US).
# ".label" is the accessible name, and is visible in the overflow menu and when
# customizing the toolbar.
# ".tooltiptext" will be identical to the label.
toolbar-new-identity =
    .label = Uus identiteet
    .tooltiptext = { toolbar-new-identity.label }
# New identity dialog.
new-identity-dialog-description = { -brand-short-name } sulgeb kõik aknad ja kaardid. Kõik senised veebisaitide sessioonid katkevad.
# Preferences - Letterboxing.
# The word "Letterboxing" is the proper noun for the Tor Browser feature, and is therefore capitalised.
# "Letterboxing" should be treated as a feature/product name, and likely not changed in other languages.
letterboxing-disabled-description = Vaate raamistamine pole hetkel kasutusel.
# Preferences - Letterboxing.
# The word "Letterboxing" is the proper noun for the Tor Browser feature, and is therefore capitalised.
# "Letterboxing" should be treated as a feature/product name, and likely not changed in other languages.
letterboxing-enable-button =
    .label = Lülita vaate raamistamine sisse
# Preferences - Letterboxing.
# The word "Letterboxing" is the proper noun for the Tor Browser feature, and is therefore capitalised.
# "Letterboxing" should be treated as a feature/product name, and likely not changed in other languages.
letterboxing-header = Vaate raamistamine
# Security level toolbar button.
# Uses sentence case in English (US).
# ".label" is the accessible name, and shown in the overflow menu and when customizing the toolbar.
security-level-toolbar-button-safest =
    .label = Turvatase
    .tooltiptext = Turvatase: kõige turvalisem
# Preferences - Letterboxing.
letterboxing-window-size-header = Akna suurus
# Preferences - Letterboxing.
letterboxing-remember-size =
    .label = Uue akna avamisel kasuta senist akna suurust
    .accesskey = R
# Preferences - Letterboxing.
letterboxing-alignment-header = Sisu joondumine
# Preferences - Letterboxing.
letterboxing-alignment-description = Vali veebisaidi sisu joondumine.
# Preferences - Letterboxing.
# The word "Letterboxing" is the proper noun for the Tor Browser feature, and is therefore capitalised.
# "Letterboxing" should be treated as a feature/product name, and likely not changed in other languages.
letterboxing-overview = { -brand-short-name }'i vaate raamistamine (Letterboxing) takistab veeisaitidel kindlat mõõtu vaadete kuvamise ja seega teeb keerukamaks kasutaja profileerimise ja tuvastamise monitori või brauserivaate suuruse alusel.
# Security level toolbar button.
# Uses sentence case in English (US).
# ".label" is the accessible name, and shown in the overflow menu and when customizing the toolbar.
security-level-toolbar-button-safer =
    .label = Turvatase
    .tooltiptext = Turvatase: turvalisem
# Security level toolbar button.
# Uses sentence case in English (US).
# ".label" is the accessible name, and shown in the overflow menu and when customizing the toolbar.
# Used when the user is in some custom configuration that does not match a security level.
security-level-toolbar-button-custom =
    .label = Turvatase
    .tooltiptext = Turvatase: kohandatud
# New identity: blocked home page notification.
# '-brand-short-name' is the localized browser name, like "Tor Browser".
# $url (String) - The URL of the home page, possibly shortened.
new-identity-blocked-home-notification = { -brand-short-name } blokeeris sinu kodulehe ({ $url }) laadimise , sest selle käigus võib olla võimalik tuvastada sinu varasemat sessiooni.
# Security level toolbar button.
# Uses sentence case in English (US).
# ".label" is the accessible name, and shown in the overflow menu and when customizing the toolbar.
security-level-toolbar-button-standard =
    .label = Turvatase
    .tooltiptext = Turvatase: tavaline
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "macOS" is a brand name, and 10.15 is the macOS version number.
dropped-support-notification-macos-version-less-than-10-15-expired = { -brand-short-name } enam ei tööta selles macOS versioonis. Palun uuenda oma arvuti operatsioonisüsteem macOS versioonini 10.15 või uuemaks ja sellega tagad uuema rakendustarkvara ja sellega kaasnevad turvauuendused.
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "Windows" is a brand name, and "Windows 10" is the version.
dropped-support-notification-win-os-version-less-than-10-expired = { -brand-short-name } enam ei tööta selles Windowsi versioonis. Palun uuenda oma arvuti operatsioonisüsteem Windowsi versioonini 10 või uuemaks ja sellega tagad uuema rakendustarkvara ja sellega kaasnevad turvauuendused.
# Notification for dropped operating system support.
dropped-support-notification-dismiss-button = Selge, sain aru
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "14.0" refers to the browser versions number: Tor Browser 14.0.
# "macOS" is a brand name, and 10.15 is the macOS version number.
dropped-support-notification-macos-version-less-than-10-15 = Järgmine { -brand-short-name } põhiversioon (14.0) enam ei tööta selles macOS versioonis. Palun uuenda hiljemalt 01.10.24 oma arvuti operatsioonisüsteem macOS versioonini 10.15 või uuemaks ja sellega tagad uuema rakendustarkvara ja sellega kaasnevad turvauuendused.
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "14.0" refers to the browser versions number: Tor Browser 14.0.
# "Windows" is a brand name, and "Windows 10" is the version.
dropped-support-notification-win-os-version-less-than-10 = Järgmine { -brand-short-name } põhiversioon (14.0) enam ei tööta selles Windowsi versioonis. Palun uuenda hiljemalt 01.10.24 oma arvuti operatsioonisüsteem Windowsi versioonini 10 või uuemaks ja sellega tagad uuema rakendustarkvara ja sellega kaasnevad turvauuendused.
