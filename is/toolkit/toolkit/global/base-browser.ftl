basebrowser-rfp-maximize-warning-message = Með því að stækka Tor-vafragluggann gerir þú vefsvæðum mögulega kleift að mæla stærð skjásins þíns, sem aftur gerir kleift að einkenna þig. Við mælum með því að þú hafir glugga Tor-vafrans í upprunalegri sjálfgefinni stærð.
# Fullscreen/maximization notification shown when letterboxing is disabled
basebrowser-rfp-restore-window-size-button-label = Endurheimta
# Tooltip for the about:addons recommended badge
