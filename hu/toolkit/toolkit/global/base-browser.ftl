# New identity: blocked home page notification.
# '-brand-short-name' is the localized browser name, like "Tor Browser".
# $url (String) - The URL of the home page, possibly shortened.
new-identity-blocked-home-notification = A { -brand-short-name } blokkolta a kezdőlapja ({ $url }) betöltését, mert az felismerheti az előző munkamenetét.
# New identity dialog.
new-identity-dialog-description = A { -brand-short-name } bezár minden ablakot és lapot. Minden munkamenet a weboldalon elveszik.
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "macOS" is a brand name, and 10.15 is the macOS version number.
dropped-support-notification-macos-version-less-than-10-15-expired = A { -brand-short-name } már nem támogatja a macOS ezen verzióját. Kérjük frissítsen macOS 10.15-re vagy újabbra, hogy továbbra is kapjon biztonsági frissítéseket.
# Notification for dropped operating system support.
dropped-support-notification-dismiss-button = Megértettem
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "Windows" is a brand name, and "Windows 10" is the version.
dropped-support-notification-win-os-version-less-than-10-expired = A { -brand-short-name } már nem támogatja a Windows ezen verzióját. Kérjük frissítsen Windows 10-re vagy újabbra, hogy továbbra is kapjon biztonsági frissítéseket.
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "14.0" refers to the browser versions number: Tor Browser 14.0.
# "macOS" is a brand name, and 10.15 is the macOS version number.
dropped-support-notification-macos-version-less-than-10-15 = A { -brand-short-name } következő fő verziója (14.0) nem fogja tovább támogatni a macOS ezen verzióját. Kérjük frissítsen macOS 10.15-re vagy újabbra 2024 október 1-ig, hogy továbbra is kapjon biztonsági frissítéseket.
# Notification for dropped operating system support.
# "{ -brand-short-name }" will be replaced with the localized name of the browser, e.g. "Tor Browser".
# "14.0" refers to the browser versions number: Tor Browser 14.0.
# "Windows" is a brand name, and "Windows 10" is the version.
dropped-support-notification-win-os-version-less-than-10 = A { -brand-short-name } következő fő verziója (14.0) nem fogja tovább támogatni a Windows ezen verzióját. Kérjük frissítsen Windows 10-re vagy újabbra 2024 október 1-ig, hogy továbbra is kapjon biztonsági frissítéseket.
